# docker/Dockerfile.test — B案 フル: bun + opencode v1/v2 + E2Eサーバ
FROM oven/bun:1.3

# 基礎
RUN apt-get update && apt-get install -y \
    git sqlite3 curl ca-certificates bash nodejs npm expect tmux \
    && rm -rf /var/lib/apt/lists/*

# opencode v1 (1.18.27) は sst 配布（npm にはない）→ install スクリプトで取得
# v2 (beta) は npm @opencode-ai/cli@beta（バイナリ opencode2）
RUN curl -fsSL https://opencode.ai/install | bash -s -- --version 1.18.27 || echo "opencode v1 install failed"
RUN npm i -g @opencode-ai/cli@beta @opencode-ai/plugin@beta || true
# パス調整: v1 は ~/.opencode/bin/opencode に入るので /usr/local/bin へリンク
RUN if [ -f /root/.opencode/bin/opencode ]; then ln -sf /root/.opencode/bin/opencode /usr/local/bin/opencode; fi \
 && if [ -f /root/.opencode/bin/opencode2 ]; then ln -sf /root/.opencode/bin/opencode2 /usr/local/bin/opencode2; fi \
 && if ! command -v opencode2 >/dev/null 2>&1 && command -v opencode >/dev/null 2>&1; then ln -sf $(command -v opencode) /usr/local/bin/opencode2; fi \
 && opencode --version 2>&1 | head; opencode2 --version 2>&1 | head || true

WORKDIR /app

    # 依存の先行キャッシュ
    COPY package.json package-lock.json tsconfig.json eslint.config.mjs ./
COPY src/ src/
COPY test/ test/
COPY scripts/ scripts/
RUN bun install --frozen-lockfile || bun install

# 本体
COPY . .

# Docker 内で opencode がプラグインを解決できるように /app を global node_modules にリンク
# + グローバル config に plugins を注入（/app は host mount で上書きされるため global config を使用）
# v1 は plugin（単数）で entry:DailyLogbookPlugin を指定（default が plain object のため named で読む）
# v2 は plugins（複数）で local dist を直接参照（publish 不要: ..:/app mount で /app/dist が利用可能）
# expect/tmux are required for TUI 70s unconditional send verification
RUN mkdir -p /usr/local/lib/node_modules && ln -sf /app /usr/local/lib/node_modules/opencode-autopilot-logbook \
 && mkdir -p /app/node_modules && ln -sf /app /app/node_modules/opencode-autopilot-logbook \
 && mkdir -p /root/.config/opencode \
 && printf '{"plugin":[{"package":"opencode-autopilot-logbook","entry":"DailyLogbookPlugin"}]}' > /root/.config/opencode/opencode.json \
 && printf '{"plugins":["/app"]}' > /root/.config/opencode/opencode.jsonc \
 && cat /root/.config/opencode/opencode.json && echo "---" && cat /root/.config/opencode/opencode.jsonc \
 && ls -l /usr/local/lib/node_modules/opencode-autopilot-logbook /app/node_modules/opencode-autopilot-logbook 2>&1 | head

# ビルド & 品質ゲート（B案では E2E は profiles:e2e で別実行）
RUN bun run build \
 && npx tsc --noEmit \
 && npx eslint . \
 && bun test \
 && bun scripts/verify-diagnostic-logs.ts \
 && npx madge --circular --extensions ts --warning . || echo "madge warnings ignored"

# デフォルトは test watch（compose で上書き）
CMD ["bun", "test", "--watch"]
