{
  "name": "opencode-autopilot-logbook",
  "version": "2.0.2",
  "description": "OpenCode plugin that auto-generates daily reports on session idle",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.jp.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build daily-logbook.ts --target=bun --outfile dist/index.js",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "daily-report",
    "logbook",
    "automation"
  ],
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "//": "V2 migration: switch to beta with `npm i -D @opencode-ai/plugin@beta` on beta branch (see CHANGELOG ## 2.0.0 - BREAKING). Current stable keeps ^1.0.0 so `bun test` stays green; V2 code uses dynamic import + fallback plain object.",
  "repository": {
    "type": "git",
    "url": "https://github.com/smapira/opencode-autopilot-logbook.git"
  },
  "license": "MIT"
}
